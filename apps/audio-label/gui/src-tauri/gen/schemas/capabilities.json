{
  "default": {
    "identifier": "default",
    "description": "Default capabilities for the app",
    "local": true,
    "windows": ["main", "settings"],
    "permissions": [
      "core:default",
      "core:webview:allow-create-webview-window",
      "shell:allow-spawn",
      "shell:allow-stdin-write",
      "shell:allow-kill",
      "shell:allow-open",
      "dialog:default"
    ]
  }
}
