{
  "name": "vera",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter=!claude-code-source build",
    "release": "bash scripts/release.sh",
    "dev": "pnpm --filter @open-vera/openvera dev",
    "dev:core": "VERA_CONFIG_DIR=../../.vera pnpm --filter @open-vera/core dev",
    "repl": "pnpm --filter @open-vera/openvera run dev --",
    "dev:watch": "VERA_CONFIG_DIR=../../.vera pnpm --filter @open-vera/core dev:watch",
    "typecheck": "pnpm -r --filter=!claude-code-source typecheck",
    "test": "pnpm -r --filter=!claude-code-source test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write packages apps eslint.config.js package.json pnpm-workspace.yaml tsconfig.base.json",
    "format:check": "prettier --check packages apps eslint.config.js package.json pnpm-workspace.yaml tsconfig.base.json",
    "flow": "pnpm --filter @open-vera/openvera exec openvera run",
    "serve": "pnpm --filter @vera/gateway-ui-server run dev --",
    "ui": "pnpm --filter @vera/gateway-ui-web dev",
    "admin": "pnpm --filter @vera/gateway-ui-web dev",
    "admin-serve": "pnpm --filter @vera/gateway-ui-server run dev --",
    "core": "pnpm --filter @vera/gateway-ui-web dev",
    "gateway": "pnpm --filter @vera/gateway-ui-server --filter @vera/gateway-ui-web --parallel run dev",
    "gateway:build": "pnpm --filter @open-vera/gateway build",
    "gateway:typecheck": "pnpm --filter @open-vera/gateway typecheck",
    "gateway:test": "pnpm --filter @open-vera/gateway test",
    "gateway-serve": "pnpm --filter @vera/gateway-ui-server run dev --",
    "gateway-serve:dist": "pnpm --filter @vera/gateway-ui-server run start --",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.0.3",
    "globals": "^17.6.0",
    "jscpd": "^4.2.4",
    "oxlint": "^1.68.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "brace-expansion@>=5.0.0 <5.0.6": "5.0.6",
      "ws@>=8.0.0 <8.20.1": "8.21.0"
    }
  }
}
