{
  "name": "vera",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter=!claude-code-source build",
    "release": "pnpm --filter @open-vera/core run release && pnpm --filter @open-vera/harness run release",
    "dev": "pnpm --filter @open-vera/core build && pnpm --filter @open-vera/harness dev",
    "dev:core": "VERA_CONFIG_DIR=../../.vera pnpm --filter @open-vera/core dev",
    "dev:watch": "VERA_CONFIG_DIR=../../.vera pnpm --filter @open-vera/core dev:watch",
    "typecheck": "pnpm -r --filter=!claude-code-source typecheck",
    "test": "pnpm -r --filter=!claude-code-source test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write packages apps eslint.config.js package.json pnpm-workspace.yaml tsconfig.base.json",
    "format:check": "prettier --check packages apps eslint.config.js package.json pnpm-workspace.yaml tsconfig.base.json",
    "flow": "pnpm --filter @open-vera/harness exec vera-harness flow run",
    "serve": "pnpm --filter @vera/harness-ui-server exec vera-serve",
    "ui": "pnpm --filter @vera/harness-ui-web dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.0.3",
    "globals": "^17.4.0",
    "jscpd": "^4.0.9",
    "oxlint": "^1.62.0",
    "prettier": "^3.8.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  }
}
