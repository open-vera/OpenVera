{
  "name": "@open-vera/core",
  "version": "0.3.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "development": "./src/types/index.ts",
      "default": "./dist/types/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "development": "./src/adapters/index.ts",
      "default": "./dist/adapters/index.js"
    },
    "./agent": {
      "types": "./dist/agent/loop.d.ts",
      "development": "./src/agent/loop.ts",
      "default": "./dist/agent/loop.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "development": "./src/config/index.ts",
      "default": "./dist/config/index.js"
    },
    "./intent": {
      "types": "./dist/intent/index.d.ts",
      "development": "./src/intent/index.ts",
      "default": "./dist/intent/index.js"
    },
    "./plan": {
      "types": "./dist/plan/index.d.ts",
      "development": "./src/plan/index.ts",
      "default": "./dist/plan/index.js"
    },
    "./repl": {
      "types": "./dist/repl/index.d.ts",
      "development": "./src/repl/index.ts",
      "default": "./dist/repl/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "development": "./src/context/index.ts",
      "default": "./dist/context/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "development": "./src/tools/index.ts",
      "default": "./dist/tools/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "development": "./src/memory/index.ts",
      "default": "./dist/memory/index.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "development": "./src/session/index.ts",
      "default": "./dist/session/index.js"
    },
    "./project-context": {
      "types": "./dist/project-context/index.d.ts",
      "development": "./src/project-context/index.ts",
      "default": "./dist/project-context/index.js"
    },
    "./prompt": {
      "types": "./dist/prompt/index.d.ts",
      "development": "./src/prompt/index.ts",
      "default": "./dist/prompt/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "development": "./src/errors.ts",
      "default": "./dist/errors.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "development": "./src/storage/index.ts",
      "default": "./dist/storage/index.js"
    }
  },
  "scripts": {
    "build": "NODE_ENV=production tsc",
    "build:watch": "tsc --watch --preserveWatchOutput",
    "dev": "tsx --tsconfig tsconfig.json src/main.ts",
    "dev:watch": "tsx watch --clear-screen=false --tsconfig tsconfig.json src/main.ts",
    "release": "pnpm build && pnpm publish --no-git-checks",
    "test": "vitest run",
    "test:smoke": "vitest run tests/p0-alignment-smoke.test.ts",
    "test:smoke:suite": "vitest run tests/p0-alignment-smoke.test.ts tests/repl-loop-smoke.test.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@open-vera/logger": "workspace:*",
    "@anthropic-ai/sdk": "^0.54.0",
    "@google/generative-ai": "^0.24.1",
    "@types/figlet": "^1.7.0",
    "better-sqlite3": "^11.0.0",
    "diff": "^8.0.4",
    "figlet": "^1.11.0",
    "ink": "^5.2.0",
    "openai": "^6.34.0",
    "react": "^18.3.0",
    "string-width": "^8.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^8.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.4",
    "ali-oss": "^6.23.0",
    "playwright": "^1.60.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  }
}
