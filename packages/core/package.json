{
  "name": "@open-vera/core",
  "version": "0.1.5",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types/index.js",
    "./adapters": "./dist/adapters/index.js",
    "./agent": "./dist/agent/loop.js",
    "./config": "./dist/config/index.js",
    "./intent": "./dist/intent/index.js",
    "./plan": "./dist/plan/index.js",
    "./repl": "./dist/repl/index.js",
    "./context": "./dist/context/index.js",
    "./tools": "./dist/tools/index.js",
    "./memory": "./dist/memory/index.js",
    "./session": "./dist/session/index.js",
    "./project-context": "./dist/project-context/index.js",
    "./prompt": "./dist/prompt/index.js",
    "./errors": "./dist/errors.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch --preserveWatchOutput",
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch --clear-screen=false src/index.ts",
    "release": "pnpm build && pnpm publish --no-git-checks",
    "test": "vitest run",
    "test:smoke": "vitest run tests/p0-alignment-smoke.test.ts",
    "test:smoke:suite": "vitest run tests/p0-alignment-smoke.test.ts tests/repl-loop-smoke.test.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "@google/generative-ai": "^0.24.1",
    "@types/figlet": "^1.7.0",
    "diff": "^8.0.4",
    "figlet": "^1.11.0",
    "ink": "^5.2.0",
    "openai": "^6.34.0",
    "react": "^18.3.0",
    "string-width": "^8.2.0"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  }
}
