{
  "name": "@open-vera/openvera",
  "version": "0.1.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "openvera": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "VERA_CONFIG_DIR=../../.vera tsx src/cli/index.ts repl --dir ../..",
    "build": "tsc",
    "postbuild": "chmod +x dist/cli/index.js",
    "release": "pnpm build && pnpm publish --no-git-checks",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@open-vera/core": "workspace:*",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
